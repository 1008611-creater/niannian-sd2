[Unit]
Description=NianNian COS runtime credential staging
After=local-fs.target
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
RuntimeDirectory=niannian-cos
RuntimeDirectoryMode=0700
LoadCredentialEncrypted=niannian-cos-secret-id:/etc/credstore.encrypted/niannian-cos-secret-id.cred
LoadCredentialEncrypted=niannian-cos-secret-key:/etc/credstore.encrypted/niannian-cos-secret-key.cred
ExecStart=/usr/local/libexec/niannian-stage-cos-runtime-env
ExecStop=/usr/bin/rm -f /run/niannian-cos/tencent-cos.env

[Install]
WantedBy=multi-user.target
