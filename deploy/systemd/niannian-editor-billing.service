[Unit]
Description=NianNian editor billing API
After=network-online.target postgresql@14-main.service
Wants=network-online.target

[Service]
Type=simple
User=niannian_redraw
Group=niannian_redraw
WorkingDirectory=/opt/niannian-editor-billing/current
EnvironmentFile=/etc/niannian-ai/redraw.env
EnvironmentFile=/etc/niannian-ai/editor-sso.env
Environment=NODE_ENV=production
Environment=PORT=18086
Environment=PATH=/opt/node24/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/opt/node24/bin/node /opt/niannian-editor-billing/current/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 18086
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/srv/niannian-data/niannian-redraw-web

[Install]
WantedBy=multi-user.target
