# Production mail delivery. Keep real values in the deployment secret manager, never in Git.
AUTH_OTP_PEPPER=replace-with-a-long-random-secret
AUTH_SESSION_SECRET=replace-with-a-different-long-random-secret
AUTH_COOKIE_SECURE=true
APP_ORIGIN=https://example.com
# Shared with edit.cauai.fun for single sign-on and server-to-server credit billing.
# Use a random value of at least 32 characters and keep it server-side only.
NIANNIAN_EDITOR_SSO_SECRET=
NIANNIAN_EDITOR_ORIGIN=https://edit.cauai.fun
DATABASE_URL=postgres://niannian:replace-with-password@database:5432/niannian
DATABASE_SSL=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="念念ai <mailer@example.com>"

# New Mimo automatic work is claimed only by the dedicated Windows Mimo CDP
# worker. Mac Codex remains a historical compatibility path for existing
# mac_codex tasks, and its token must not be reused by either Windows worker.
# Keep each agent secret in its own deployment/Windows secret store.
MAC_CODEX_AGENT_TOKEN=replace-with-a-dedicated-random-agent-secret
DOLA_CODEX_AGENT_TOKEN=replace-with-a-separate-windows-dola-agent-secret
MIMO_WINDOWS_AGENT_TOKEN=replace-with-a-separate-windows-mimo-agent-secret
MAC_CODEX_LEASE_SECONDS=1200
MAC_CODEX_HEARTBEAT_TTL_SECONDS=120
MAC_CODEX_READINESS_TTL_SECONDS=180
DOLA_CODEX_LEASE_SECONDS=1200
DOLA_CODEX_READINESS_TTL_SECONDS=180
MIMO_WINDOWS_LEASE_SECONDS=1200
MIMO_WINDOWS_READINESS_TTL_SECONDS=180

# LDXP (链动小铺) card-code checkout. Codes are HMAC signed and single-use.
LDXP_SHOP_URL=https://pay.ldxp.cn/shop/replace-with-shop-id
LDXP_REDEEM_SECRET=replace-with-a-dedicated-random-secret-at-least-32-characters

# The in-container worker is auxiliary only. It must not claim Mimo Windows
# tasks, which are isolated behind the authenticated Windows CDP Agent API.
# Add codex_skill only on the Windows workstation that owns Dola2API.
VIDEO_WORKER_MODES=server_auto
VIDEO_WORKER_POLL_MS=5000
VIDEO_CODEX_TIMEOUT_MS=2700000
CODEX_VIDEO_MODEL=gpt-5.5

# Channel M readiness check. Keep credentials in secret management only.
MIMO_BASE_URL=https://fd.aancn.cn
MIMO_USERNAME=
MIMO_PASSWORD=
MIMO_TOKEN=

# Miora 方法13 uses an already logged-in Chrome CDP session. Do not place browser
# cookies in committed files; the submit flag is an additional explicit safety gate.
MIORA_BASE_URL=https://miora.design
MIORA_CDP_URL=http://127.0.0.1:9415
MIORA_COOKIE=
MIORA_PROVIDER_SUBMIT_ENABLED=false

# Local Windows Dola2API bridge. Only loopback HTTP endpoints are accepted.
DOLA2API_BASE_URL=http://127.0.0.1:9190

# Optional server-auto adapter. Keep its bearer token in secret management.
VIDEO_SERVER_DISPATCH_URL=
VIDEO_SERVER_DISPATCH_TOKEN=

# Server-side redraw runtime. Store real values only in deployment secrets.
REDRAW_REDIS_URL=redis://redraw-redis:6379
REDRAW_WORKER_CONCURRENCY=1
REDRAW_CLAIM_RECOVERY_MS=900000
REDRAW_SKILL_BUNDLE_VERSION=redraw-runtime-1
NIANNIAN_GPT_API_BASE_URL=https://www.mcgrox.top
NIANNIAN_GPT_RESPONSES_PATH=/responses
NIANNIAN_GPT_API_KEY=replace-with-server-only-key
NIANNIAN_GPT56_MODEL=gpt-5.6
RUNNINGHUB_BASE_URL=https://www.runninghub.cn
RUNNINGHUB_API_KEY=replace-with-server-only-key
ZIYU_BASE_URL=https://ziyuai.vip
ZIYU_API_KEY=replace-with-server-only-key
TENCENT_COS_SECRET_ID=replace-with-server-only-secret-id
TENCENT_COS_SECRET_KEY=replace-with-server-only-secret-key
TENCENT_COS_BUCKET=replace-with-private-bucket
TENCENT_COS_REGION=replace-with-region
