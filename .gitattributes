# 统一换行，杜绝本次审计的根因：.env 被写成 CRLF 导致键名/值被污染
* text=auto eol=lf

# 环境变量文件强制 LF、无 BOM
.env text eol=lf
.env.* text eol=lf
*.env text eol=lf

# 脚本强制 LF（Windows 上尤其重要）
*.sh text eol=lf
*.mjs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 二进制不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.webm binary
*.woff2 binary
*.zip binary
*.gz binary
