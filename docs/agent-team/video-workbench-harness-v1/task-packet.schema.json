{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "niannian-video-workbench-task-packet-v1",
  "title": "Immutable NianNian Video Workbench Task Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "created_at",
    "project",
    "objective",
    "user_binding",
    "production_spec",
    "locked_prompt",
    "scope",
    "dependencies",
    "acceptance_criteria",
    "authority_gate",
    "cost_gate",
    "writer_surfaces",
    "artifact_roles",
    "replaces_packet_sha256"
  ],
  "properties": {
    "schema_version": { "const": "niannian_video_workbench_task_packet_v1" },
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,99}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "project": { "const": "niannian-ai-video-workbench" },
    "objective": { "type": "string", "minLength": 1 },
    "user_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_account", "user_surface", "website_credit_reservation", "customer_paths"],
      "properties": {
        "owner_account": { "type": "string", "format": "email" },
        "user_surface": { "const": "https://sd2.cauai.fun" },
        "website_credit_reservation": { "type": "number", "const": 16 },
        "customer_paths": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "enum": ["create", "project_visibility", "playback", "download"] } }
      }
    },
    "production_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_type", "reference_sha256", "model", "duration_seconds", "aspect_ratio", "resolution", "channel", "execution_mode", "maximum_generate_attempts"],
      "properties": {
        "generation_type": { "const": "image_to_video" },
        "reference_sha256": { "const": "59388ad9cc2e37e5d54b03b24f303fb0d83a6a740b4f0d1c9ab7e8af4c375454" },
        "model": { "const": "Seedance 2.0" },
        "duration_seconds": { "const": 4 },
        "aspect_ratio": { "const": "16:9" },
        "resolution": { "const": "720P" },
        "channel": { "const": "mimo" },
        "execution_mode": { "const": "codex_skill" },
        "maximum_generate_attempts": { "const": 1 }
      }
    },
    "locked_prompt": { "const": "一名年轻男子在未来感便利店里拿起一瓶普通矿泉水，瓶盖打开瞬间，整个便利店像失重空间一样漂浮起来，零食和彩色包装缓慢环绕他旋转。他先惊讶地环顾四周，随后对镜头露出得意微笑，喝下一口水。电影感运镜，真实人物，动作自然，光影清晰，无文字，无水印。" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_paths", "forbidden_projects", "external_actions"],
      "properties": {
        "allowed_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "forbidden_projects": { "type": "array", "minItems": 4, "items": { "type": "string" } },
        "external_actions": { "type": "array", "items": { "enum": ["provider_submit", "spend", "deploy", "migration", "delete", "promotion"] } }
      }
    },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "authority_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "authorization_id", "authorized_actions"],
      "properties": {
        "required": { "type": "boolean" },
        "authorization_id": { "type": ["string", "null"] },
        "authorized_actions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cost_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "currency", "expected", "maximum", "authorized"],
      "properties": {
        "required": { "type": "boolean" },
        "currency": { "type": ["string", "null"] },
        "expected": { "type": ["number", "null"], "minimum": 0 },
        "maximum": { "type": ["number", "null"], "minimum": 0 },
        "authorized": { "type": "boolean" }
      }
    },
    "writer_surfaces": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "artifact_roles": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "replaces_packet_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
  }
}
